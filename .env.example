PORT=3000

# Number of reverse proxies in front of the API (nginx/Caddy = 1, Cloudflare + nginx = 2,
# 0 = exposed directly). Needed for per-IP rate limits to see the real client IP.
TRUST_PROXY=1

MONGODB_URI=mongodb://admin:YourStrongPassword123@localhost:27017/zawaj?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# One-time seed for the super-admin's password (POST /admin-auth/login), only
# used the first time no admin credential exists yet in the database — change
# it from the admin dashboard afterwards. ADMIN_API_KEY is kept only as a
# fallback seed for deployments that already had it set.
ADMIN_INITIAL_PASSWORD=change-me-admin-password
ADMIN_API_KEY=change-me-admin-key

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me-vapid-public-key
VAPID_PRIVATE_KEY=change-me-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=YourStrongPassword123
